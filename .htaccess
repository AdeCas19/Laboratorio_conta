Options -Indexes

# Documentación interna y diagnóstico: no deben descargarse desde el navegador.
<FilesMatch "^(README.*\.md|debug_login\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
